<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme — dark to match the PWA -->
    <style name="Theme.Ground" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0a0a1a</item>
        <item name="android:navigationBarColor">#0a0a1a</item>
        <item name="android:windowBackground">#0a0a1a</item>
    </style>

    <!-- Launch theme — shown briefly while TWA loads -->
    <style name="Theme.Ground.Launch" parent="Theme.Ground">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
